{
  "compilerOptions": {
    // tsup's DTS step injects a baseUrl, which TS 6 flags as deprecated; this
    // keeps `pnpm --filter @book.dev/server build` green until TS 7.
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // The LGR-13 beancount gate test imports the ledger plugin's report fold
    // from its shipped sources; the plugin's `@book.dev/plugin-sdk` imports
    // resolve to the sdk — the same mapping the plugin host performs at
    // runtime (ui `hostModulesFor`). Mirrored for the test runner in
    // vitest.config.ts.
    "paths": {
      "@book.dev/plugin-sdk": ["../sdk/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
