{
  "name": "@book.dev/ui",
  "version": "3.15.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lab255/OpenBook.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "module": "dist/index.js",
  "scripts": {
    "build": "pnpm run gen:bundled-plugins && pnpm run build:viewer && vite build && tsc",
    "gen:bundled-plugins": "node --import tsx scripts/bundlePlugins.ts",
    "check:gen": "pnpm run gen:bundled-plugins && (git diff --exit-code -- src/plugins/bundled.gen.ts src/export/ledgerFolds.gen || (echo 'Committed .gen mirror is STALE: run pnpm --filter @book.dev/ui run gen:bundled-plugins and commit the result.' >&2 && exit 1))",
    "build:viewer": "vite build --config vite.viewer.config.js",
    "gen:export-fixtures": "vitest run scripts/exportParityFixtures.test.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "dev": "vite build --watch",
    "dev-css": "pnpm exec tailwindcss --input ./src/index.css --output ./dist/index.css --watch",
    "dev-types": "tsc --watch",
    "lint": "eslint . && pnpm run lint:css && pnpm run test:stylelint",
    "lint:css": "stylelint src/index.css",
    "lint-fix": "eslint . --fix",
    "test:stylelint": "node scripts/assert-spacing-stylelint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@book.dev/sdk": "workspace:*",
    "@heroicons/react": "^2.1.5",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@observablehq/plot": "^0.6.17",
    "@preact/signals-core": "^1.14.2",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dismissable-layer": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "dom-to-svg": "0.12.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "node-emoji": "^2.2.0",
    "quickjs-emscripten-core": "0.32.0",
    "react-leaflet": "^5.0.0",
    "sucrase": "^3.35.1",
    "svg2pdf.js": "^2.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "use-immer": "^0.11.0",
    "use-resize-observer": "^9.1.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "d3": "^7.9.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.47",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
