{
  "name": "@book.dev/sdk",
  "version": "3.15.2",
  "description": "Shared OpenBook types and HTTP client used by the server, desktop, and web.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lab255/OpenBook.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "vitest run"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "marked": "^18.0.5"
  }
}
