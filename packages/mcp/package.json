{
  "name": "@book.dev/mcp",
  "version": "3.14.0",
  "description": "OpenBook MCP server: lets MCP clients (Claude Desktop, Claude Code, …) read and write an OpenBook workspace over stdio.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "openbook-mcp": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin.js",
    "test": "node --import tsx scripts/listed.test.mts && tsx scripts/suggestions.test.mts && tsx scripts/blocks.test.mts && tsx scripts/tables.test.mts && tsx scripts/forms.test.mts && tsx scripts/blockTypes.test.mts && tsx scripts/endpoint.test.mts",
    "test:listed": "node --import tsx scripts/listed.test.mts",
    "test:blocktypes": "tsx scripts/blockTypes.test.mts",
    "test:blocks": "tsx scripts/blocks.test.mts",
    "test:tables": "tsx scripts/tables.test.mts",
    "test:forms": "tsx scripts/forms.test.mts",
    "test:endpoint": "tsx scripts/endpoint.test.mts",
    "test:e2e": "tsx scripts/e2e.mts",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@book.dev/sdk": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@book.dev/server": "workspace:*",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3"
  }
}
